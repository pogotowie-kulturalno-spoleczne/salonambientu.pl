---
import EventRow from './EventRow.astro';
import { groupByMonth, type EventView } from '../lib/events';

interface Props {
  events: EventView[];
  /** Reverted-to theme when nothing is hovered (soonest event). */
  defaultTheme: string;
}

const { events, defaultTheme } = Astro.props;
const months = groupByMonth(events);
---

{/* Poster list: one heading per month, editions stacked underneath. */}
<div id="event-list" class="flex w-full flex-col gap-mgroup" data-default-theme={defaultTheme}>
  {
    months.map((group) => (
      <section class="flex flex-col gap-mrow">
        <h2 class="text-month capitalize leading-[0.84]">{group.label}</h2>
        <ul class="flex flex-col gap-mrow">
          {group.events.map((e) => (
            <EventRow event={e} />
          ))}
        </ul>
      </section>
    ))
  }
</div>

{/* Hover re-theming is wired globally in Layout.astro, by delegation over
    anything carrying data-theme. */}
