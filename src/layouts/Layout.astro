---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import KeyVisual from '../components/KeyVisual.astro';
import Footer from '../components/Footer.astro';
import GrantNotice from '../components/GrantNotice.astro';
import { themeBlocks, type ThemeKey, type ThemePalette } from '../lib/themes';

interface Props {
  title?: string;
  description?: string;
  defaultTheme: ThemeKey;
  /** Palettes this page can switch between on hover. */
  palettes?: { key: ThemeKey; palette: ThemePalette }[];
  /** Extra partner keys for the footer, on top of the site-wide ones. */
  partnerKeys?: readonly string[];
  /** Site-relative path to this page's generated social card. */
  ogPath?: string;
  /** Where the key visual's sharp rectangle starts / ends, e.g. "8%". */
  kvTop?: string;
  kvBottom?: string;
}

const {
  title = 'Salony Ambientu | Muzyka ambient na żywo',
  // Deliberately city-free: unannounced editions must not leak through meta.
  description = 'Cykl Salonów Ambientu — spotkania z muzyką ambient na żywo. Sprawdź nadchodzące edycje i pełny line-up.',
  defaultTheme,
  palettes = [],
  partnerKeys = [],
  ogPath = '/og.png',
  kvTop,
  kvBottom,
} = Astro.props;

const kvStyle = [
  kvTop && `--kv-top:${kvTop}`,
  kvBottom && `--kv-bottom:${kvBottom}`,
]
  .filter(Boolean)
  .join(';');

const themeStyles = themeBlocks(palettes);

const siteName = 'Salony Ambientu';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogPath, Astro.site);

// Adobe Fonts (Typekit) kit serving Neue Haas Grotesk Display Pro.
// Inter Tight stays as the self-hosted metrics-close fallback (global.css).
const TYPEKIT_KIT_ID = 'wpm5boa';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f3c962" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Salony Ambientu" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      TYPEKIT_KIT_ID && (
        <>
          <link rel="preconnect" href="https://use.typekit.net" />
          <link rel="preconnect" href="https://p.typekit.net" crossorigin />
          <link rel="stylesheet" href={`https://use.typekit.net/${TYPEKIT_KIT_ID}.css`} />
        </>
      )
    }

    {/* Cross-document view transitions: the key visual's shapes carry
        view-transition-names, so the browser morphs them between pages. */}
    <ClientRouter />

    <slot name="head" />
  </head>
  <body>
    {/* Poster wrap: flat canvas across the whole poster, carrying the palette
        vars every layer inherits. The grant disclosure below runs on paper. */}
    <div
      id="poster-bg"
      data-theme={defaultTheme}
      class="relative flex min-h-dvh flex-col items-center gap-section overflow-hidden bg-[var(--canvas)] p-gutter text-ink"
    >
      {/* The glow only backs the content; the logo footer sits below it on the
          flat canvas, as in the Figma layout. */}
      <div
        class="relative flex w-full max-w-poster flex-1 flex-col"
        style={kvStyle || undefined}
      >
        <KeyVisual />
        <slot />
      </div>

      <Footer extraKeys={partnerKeys} />
    </div>

    <style is:inline set:html={themeStyles}></style>

    <GrantNotice />

    <script>
      import { navigate } from 'astro:transitions/client';

      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const INTRO_MS = 6400;
      const OUT_MS = 420;

      let timer: number | undefined;

      /**
       * The intro itself is pure CSS — it runs while `data-kv-ready` is absent.
       * This just marks the end of it, handing the halos over to the idle
       * breathing loop.
       */
      /** The palette the current page rests on when nothing is hovered. */
      let baseTheme = '';

      function poster() {
        return document.getElementById('poster-bg');
      }

      function setTheme(theme: string | undefined) {
        const bg = poster();
        if (bg && theme) bg.dataset.theme = theme;
      }

      function lightUp() {
        window.clearTimeout(timer);
        baseTheme = poster()?.dataset.theme ?? '';
        root.removeAttribute('data-kv-out');
        if (reduce) {
          root.setAttribute('data-kv-ready', '');
          return;
        }
        root.removeAttribute('data-kv-ready');
        timer = window.setTimeout(() => root.setAttribute('data-kv-ready', ''), INTRO_MS);
      }

      lightUp();

      /**
       * Hovering anything that names a palette previews it on the background:
       * an edition row on the homepage, the back control on a subpage. Wired
       * by delegation so it survives navigations and covers new markup.
       */
      const THEMED = '[data-theme]:not(#poster-bg)';

      function preview(event: Event) {
        const el = (event.target as Element | null)?.closest?.(THEMED);
        if (el instanceof HTMLElement) setTheme(el.dataset.theme);
      }

      function revert(event: Event) {
        const el = (event.target as Element | null)?.closest?.(THEMED);
        if (!el) return;
        const to = (event as MouseEvent | FocusEvent).relatedTarget;
        if (to instanceof Node && el.contains(to)) return;
        setTheme(baseTheme);
      }

      document.addEventListener('pointerover', preview);
      document.addEventListener('pointerout', revert);
      document.addEventListener('focusin', preview);
      document.addEventListener('focusout', revert);

      /**
       * Drive the navigation ourselves so the halos have time to go dark
       * before the swap: fade, then hand over to the router.
       */
      document.addEventListener('click', (event) => {
        if (reduce || event.defaultPrevented) return;
        const e = event as MouseEvent;
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

        const link = (e.target as Element | null)?.closest?.('a[href]') as
          | HTMLAnchorElement
          | null;
        if (!link || (link.target && link.target !== '_self')) return;
        if (link.hasAttribute('download') || link.dataset.astroReload !== undefined) return;

        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin) return;
        if (url.pathname === location.pathname) return;

        e.preventDefault();
        root.setAttribute('data-kv-out', '');
        window.setTimeout(() => navigate(url.href), OUT_MS);
      });

      // New page, new palette — light it up from scratch.
      document.addEventListener('astro:after-swap', lightUp);
    </script>
  </body>
</html>
